{
  "uid": "go-demo-slo",
  "title": "go-demo / Service SLOs",
  "tags": ["platform", "go-demo"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by route",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, route) (rate(http_requests_total{namespace=\"demo\"}[1m]))",
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "5xx error ratio (5m)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{namespace=\"demo\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{namespace=\"demo\"}[5m]))",
          "legendFormat": "error ratio"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Available replicas (all deployments)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment) (kube_deployment_status_replicas_available{namespace=\"demo\"})",
          "legendFormat": "{{deployment}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Request latency quantiles",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"demo\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"demo\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"demo\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Server scale: HPA desired vs available",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"demo\",horizontalpodautoscaler=\"go-demo-server\"}",
          "legendFormat": "HPA desired"
        },
        {
          "refId": "B",
          "expr": "kube_deployment_status_replicas_available{namespace=\"demo\",deployment=\"go-demo-server\"}",
          "legendFormat": "available"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Pod CPU usage vs container request",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"demo\",container!=\"\"}[2m]))",
          "legendFormat": "{{pod}}"
        },
        {
          "refId": "B",
          "expr": "avg(kube_pod_container_resource_requests{namespace=\"demo\",resource=\"cpu\",container=\"server\"})",
          "legendFormat": "server CPU request"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Worker: jobs processed vs replicas",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(worker_jobs_processed_total[1m]))",
          "legendFormat": "jobs/s processed"
        },
        {
          "refId": "B",
          "expr": "kube_deployment_status_replicas_available{namespace=\"demo\",deployment=\"go-demo-worker\"}",
          "legendFormat": "worker replicas"
        }
      ]
    }
  ]
}
